# Porta da API
PORT=3002

# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:sua_senha_aqui@localhost:5434/your_finances_db?schema=public"

# Segredo para assinatura dos tokens JWT
JWT_SECRET="sua_chave_secreta_jwt_aqui"

# Chave da API do Resend para envio de e-mails transacionais (https://resend.com)
# Em desenvolvimento local, se deixado vazio, os links serão exibidos no console
RESEND_API_KEY=""

# URL do frontend para os links de redefinição de senha
FRONTEND_URL="http://localhost:5173"
